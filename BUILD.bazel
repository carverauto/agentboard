load("@io_bazel_rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//visibility:public"])

exports_files(["go.mod", "go.sum"])

# Go CLI entrypoint (agents call `agentboard`).
alias(
    name = "agentboard",
    actual = "//cmd/agentboard:agentboard",
)

filegroup(
    name = "release_artifacts",
    srcs = [
        "//build/release:cli_artifacts",
        "//build/release:dashboard",
        "//build/release:dashboard.digest",
        "//web:release",
    ],
)

test_suite(
    name = "acceptance",
    tests = [
        "//internal/client:client_test",
        "//internal/cli:cli_test",
        "//web:rate_limits_test",
        "//build/integration:postgres_tls_test",
        "//build/integration:db_tls_guard_test",
        "//build/integration:release_schema_test",
        "//build/integration:board_api_test",
        "//build/integration:image_startup_test",
        "//build/release:cli_artifacts_test",
        "//build/release:workflow_tools_test",
    ],
)

go_library(
    name = "skill_bundle",
    srcs = ["skill_bundle.go"],
    embedsrcs = glob(["skills/*/SKILL.md"]) + ["docs/api.md", "docs/quota.md", "docs/participation.md", "GROK_BOT.md"],
    importpath = "github.com/carverauto/agentboard",
)
filegroup(name = "format_srcs", srcs = ["skill_bundle.go"])
