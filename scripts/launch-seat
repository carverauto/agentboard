#!/usr/bin/env python3
"""Launch an explicitly requested native seat in a leased Treehouse v3 checkout."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

VERSION = "3.1.2"
STATE_FILE = "treehouse-state.json"


def run(argv, cwd, timeout=15):
    result = subprocess.run(argv, cwd=cwd, text=True, capture_output=True, timeout=timeout)
    if result.returncode:
        raise RuntimeError(f"{argv[0]} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def git(cwd, *args):
    return run(["git", *args], cwd)


def probe(argv, cwd, timeout=15):
    """Run argv without raising; return (returncode, stdout, stderr)."""
    try:
        result = subprocess.run(argv, cwd=cwd, text=True, capture_output=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as error:
        return 127, "", str(error)
    return result.returncode, result.stdout.strip(), result.stderr.strip()


SEAT_RECORD_PREFIX = "agentboard-seat"


def seat_body(worktree, root, holder):
    payload = json.dumps({"worktree": str(worktree), "treehouse_version": VERSION, "treehouse_root": str(root), "lease_holder": holder}, separators=(",", ":"))
    return f"{SEAT_RECORD_PREFIX} {payload}"


def record_slot(task, worktree, root, holder):
    """Best-effort slot record on the task. Warns only; never blocks launch."""
    exe = shutil.which("agentboard")
    if not exe:
        print("agentboard CLI not on PATH; skipping slot record", file=sys.stderr)
        return False
    code, _, _ = probe([exe, "task", "update", task, "--body", seat_body(worktree, root, holder)], str(worktree))
    if code:
        print(f"slot record on task {task} failed; continuing without it", file=sys.stderr)
        return False
    return True


def task_state(task, worktree):
    """Return (status, pr_url) or (None, None) when unreadable."""
    exe = shutil.which("agentboard")
    if not exe:
        return None, None
    code, out, _ = probe([exe, "task", "show", task, "--json"], str(worktree))
    if code:
        return None, None
    try:
        data = json.loads(out)
    except ValueError:
        return None, None
    record = data.get("task", data) if isinstance(data, dict) else {}
    if not isinstance(record, dict):
        return None, None
    return record.get("status"), record.get("pr_url")


def landed(worktree):
    """Firstmate-style landed gate. Returns (True, '') or (False, reason)."""
    code, dirty, _ = probe(["git", "status", "--porcelain"], str(worktree))
    if code or dirty:
        return False, "uncommitted changes" if dirty else "cannot read worktree status"
    code, head, _ = probe(["git", "rev-parse", "HEAD"], str(worktree))
    if code or not head:
        return False, "cannot read HEAD"
    code, remotes, _ = probe(["git", "branch", "-r", "--contains", head], str(worktree))
    if not code and remotes.strip():
        return True, ""
    code, _, _ = probe(["git", "merge-base", "--is-ancestor", head, "origin/main"], str(worktree))
    if not code:
        return True, ""
    return False, "HEAD is not reachable from any remote branch"


def note_slot(task, worktree, text):
    exe = shutil.which("agentboard")
    if not exe:
        return
    probe([exe, "task", "update", task, "--body", text], str(worktree))


def maybe_return_slot(task, worktree, root, binary, holder):
    """Gated return after session exit. Never --force; retains on any doubt."""
    status, _ = task_state(task, worktree)
    if status not in ("done", "cancelled"):
        print(f"Retained lease at {worktree}; task {task} is {status or 'unreadable'}, not done/cancelled.", file=sys.stderr)
        return
    ok, reason = landed(worktree)
    if not ok:
        print(f"Retained lease at {worktree}; landed gate refused: {reason}.", file=sys.stderr)
        note_slot(task, worktree, f"slot retained: {reason} at {worktree}; push or park first, never --force")
        return
    code, out, err = probe([binary, "return", str(worktree), "--if-lease-holder", holder, "--root", str(root)], str(worktree), timeout=120)
    if code:
        detail = err.strip() or out.strip()
        print(f"Retained lease at {worktree}; treehouse return failed: {detail}.", file=sys.stderr)
        note_slot(task, worktree, f"slot retained: return failed at {worktree}; lease still held")
        return
    print(f"Returned Treehouse v{VERSION} lease at {worktree} after task {task} landed.", file=sys.stderr)


def repository(source):
    source = source.resolve(strict=True)
    if Path(git(source, "rev-parse", "--show-toplevel")).resolve(strict=True) != source:
        raise RuntimeError("source cwd must be the repository root")
    common = Path(git(source, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve(strict=True)
    return source, common


def isolated(candidate, source, common):
    candidate = candidate.resolve(strict=True)
    physical = Path(run(["pwd", "-P"], candidate)).resolve(strict=True)
    top = Path(git(candidate, "rev-parse", "--show-toplevel")).resolve(strict=True)
    own_git = Path(git(candidate, "rev-parse", "--absolute-git-dir")).resolve(strict=True)
    own_common = Path(git(candidate, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve(strict=True)
    if physical != candidate or top != candidate:
        raise RuntimeError("cwd is not the exact physical worktree root")
    if candidate == source or own_git == common:
        raise RuntimeError("primary checkout or spawning checkout is forbidden")
    if own_common != common:
        raise RuntimeError("worktree belongs to another repository")
    registered = []
    for line in git(source, "worktree", "list", "--porcelain").splitlines():
        if line.startswith("worktree "):
            try:
                registered.append(Path(line[9:]).resolve(strict=True))
            except OSError:
                continue
    if candidate not in registered:
        raise RuntimeError("worktree is not registered with the source repository")
    return physical


def pool_root(value):
    """Return the explicit absolute v3 pool root, refusing roots that hold other-version pools."""
    if not value or not value.strip():
        raise RuntimeError("pool root is required: pass --root or set AGENTBOARD_SEAT_ROOT (absolute path)")
    root = Path(value).expanduser()
    if not root.is_absolute():
        raise RuntimeError(f"pool root must be absolute, got {value!r}")
    if root.is_symlink():
        raise RuntimeError("pool root must not be a symlink")
    pools = root / ".treehouse"
    if pools.is_dir():
        for state in sorted(pools.glob(f"*/{STATE_FILE}")):
            try:
                data = json.loads(state.read_text(encoding="utf-8"))
            except (OSError, ValueError) as error:
                raise RuntimeError(f"cannot verify Treehouse pool state {state}: {error}")
            # Treehouse v2 state has no version field; v3 writes an integer state version.
            if not isinstance(data, dict) or not isinstance(data.get("version"), int):
                raise RuntimeError(f"pool root holds a pool managed by another Treehouse version: {state.parent}")
    return root


def brief(text, worktree, source):
    return f"""# Agentboard seat isolation — check before editing

Expected disposable Treehouse worktree: {worktree}
Source checkout (do not edit): {source}
Persistent Treehouse v{VERSION} lease holder: $AGENT_ID (pool root $AGENTBOARD_SEAT_ROOT).

Run `pwd -P` and `git rev-parse --show-toplevel`. Both physical paths MUST
match $AGENTBOARD_SEAT_WORKTREE. Run the source repository's
`scripts/launch-seat --repo \"$AGENTBOARD_SEAT_SOURCE\" --check` as well.
If either check fails, or this is the primary checkout, STOP. Do not branch,
edit, commit or push here. Report the isolation failure to your coordinator
and mark your owned task blocked after checking its live claim. Resume only
in the correctly leased disposable worktree. Backend hosting is not isolation.
Keep this STOP condition in subsequent ship briefs. Hooks are backstops only.
Retain the worktree lease through PR review and green CI; do not merge.
When the task is done or cancelled and its work has landed (pushed, PR
merged, or already in base), return the slot with the same-version
`treehouse return` before claiming or acquiring anything new; never
--force, never rm -rf.
For ask-user gates, read the installed agentboard ask-user-escalation procedure.
On schema20 create one durable decision with verbatim findings, notify the
configured coordinator, and end the turn only after delivery. Resume by reading
the canonical answer, applying it through the active no-mistakes gate, explicitly
renewing the task and acknowledging the decision. Never answer your own gate,
pass --yes, or bypass a held claim; older APIs use the documented board fallback.
Before starting/reattaching a publication run or answering a gate, check the task
and linked/head-branch PR merge state. Use `scripts/publish-seat TASK -- run`
(or `respond`) to verify state and bind a native pre-push guard. A terminal task
or merged PR means STOP; inspect native custody and abort its stale active run,
then report to the coordinator. Do not recreate its branch or a second PR.
Only an explicitly authorized remaining delta may ship on a new branch from
fresh main. Hook refusal never authorizes a direct push or --no-verify.

# Assigned brief (verbatim)

{text}"""


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", type=Path, required=True, help="source repository root")
    parser.add_argument("--brief", type=Path, help="authorized task brief")
    parser.add_argument("--task", help="agentboard task id: record the leased slot on it, and after session exit run the gated return when the task is done/cancelled and landed")
    parser.add_argument("--root", help="absolute Treehouse v3 pool root (default: $AGENTBOARD_SEAT_ROOT)")
    parser.add_argument("--check", action="store_true", help="check current cwd against seat environment; no acquisition or launch")
    parser.add_argument("command", nargs=argparse.REMAINDER, help="native argv after --; use {brief_text} or {brief} as a whole argument")
    args = parser.parse_args()
    tainted = sorted(name for name in ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE") if os.environ.get(name) is not None)
    if tainted:
        raise RuntimeError(f"inherited {'/'.join(tainted)} is forbidden; unset GIT_DIR, GIT_WORK_TREE, GIT_COMMON_DIR, GIT_INDEX_FILE and retry")
    source, common = repository(args.repo)
    if args.check:
        expected = os.environ.get("AGENTBOARD_SEAT_WORKTREE")
        if not expected:
            raise RuntimeError("AGENTBOARD_SEAT_WORKTREE is missing")
        actual = isolated(Path.cwd(), source, common)
        if actual != Path(expected).resolve(strict=True):
            raise RuntimeError("cwd differs from the expected seat worktree")
        print(actual)
        return 0
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command or not any(arg in ("{brief}", "{brief_text}") for arg in command):
        raise RuntimeError("native argv must consume {brief} or {brief_text}")
    for key in ("AGENT_ID", "AGENTBOARD_HARNESS", "AGENTBOARD_MODEL"):
        if not os.environ.get(key, "").strip():
            raise RuntimeError(f"{key} is required")
    if not args.brief:
        raise RuntimeError("--brief is required")
    task_brief = args.brief.read_text(encoding="utf-8")
    root = pool_root(args.root if args.root is not None else os.environ.get("AGENTBOARD_SEAT_ROOT", ""))
    binary = os.environ.get("AGENTBOARD_TREEHOUSE_BIN", str(Path.home() / f".local/share/agentboard/tools/treehouse/v{VERSION}/treehouse"))
    version = run([binary, "--version"], source)
    if version != f"v{VERSION}":
        raise RuntimeError(f"expected Treehouse {VERSION}, got {version!r}; run scripts/install-treehouse")
    # The explicit --root overrides TREEHOUSE_ROOT and treehouse.toml, so pools never mix versions.
    candidate = Path(run([binary, "get", "--lease", "--lease-holder", os.environ["AGENT_ID"], "--root", str(root)], source, timeout=90))
    if not candidate.is_absolute():
        raise RuntimeError("Treehouse did not return one absolute leased path")
    try:
        worktree = isolated(candidate, source, common)
        if not worktree.is_relative_to(root.resolve(strict=True) / ".treehouse"):
            raise RuntimeError(f"leased worktree is outside the requested pool root {root}")
        time.sleep(0.1)
        if isolated(candidate, source, common) != worktree:
            raise RuntimeError("worktree cwd did not settle")
        seat_dir = worktree / ".agentboard-seat"
        # Reject redirected metadata writes before touching the worktree.
        if seat_dir.is_symlink() or (seat_dir.exists() and not seat_dir.is_dir()):
            raise RuntimeError("seat metadata directory is redirected")
        seat_dir.mkdir(mode=0o700, exist_ok=True)
        os.chmod(seat_dir, 0o700)
        brief_path = seat_dir / "brief.md"
        emitted = brief(task_brief, worktree, source)
        fd = os.open(brief_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(emitted)
        command = [str(brief_path) if arg == "{brief}" else emitted if arg == "{brief_text}" else arg for arg in command]
        env = dict(os.environ, AGENTBOARD_SEAT_WORKTREE=str(worktree), AGENTBOARD_SEAT_SOURCE=str(source), AGENTBOARD_SEAT_BRIEF=str(brief_path), AGENTBOARD_SEAT_ROOT=str(root))
        isolated(worktree, source, common)
        holder = os.environ["AGENT_ID"]
        if args.task:
            record_slot(args.task, worktree, root, holder)
        print(f"Seat cwd: {worktree}; retained Treehouse v{VERSION} lease holder: {holder} (root {root})", file=sys.stderr)
        code = subprocess.call(command, cwd=worktree, env=env)
        if args.task:
            maybe_return_slot(args.task, worktree, root, binary, holder)
        return code
    except Exception:
        print(f"Retained lease at {candidate}; inspect before any explicit 'treehouse return {candidate}'.", file=sys.stderr)
        raise


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"STOP: seat isolation failed: {error}", file=sys.stderr)
        sys.exit(2)
