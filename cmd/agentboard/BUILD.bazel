load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "agentboard_lib",
    srcs = ["main.go"],
    importpath = "github.com/carverauto/agentboard/cmd/agentboard",
    visibility = ["//visibility:private"],
    deps = ["//internal/cli"],
)

go_binary(
    name = "agentboard",
    embed = [":agentboard_lib"],
)

[go_binary(
    name = "agentboard_" + os + "_" + arch,
    embed = [":agentboard_lib"],
    goos = os,
    goarch = arch,
    pure = "on",
) for os in ["linux", "darwin"] for arch in ["amd64", "arm64"]]

filegroup(name = "format_srcs", srcs = glob(["*.go"]), visibility = ["//visibility:public"])
