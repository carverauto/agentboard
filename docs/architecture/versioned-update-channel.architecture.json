        "No deployment or agent-session restart"
      ]
    },
    {
      "dot": "emerald",
      "title": "Durable coordination",
      "items": [
        "No singleton query or polling process",
        "Stale provider state stays visibly stale"
      ]
    },
    {
      "dot": "amber",
      "title": "Design boundary",
      "items": [
        "Captain-approved release / skills / opt-in policy",
        "#127 owns installer + release triggers"
      ]
    }
  ]
