    {"id": "availability-dialog", "lane": "captain-ui", "col": 1, "type": "frontend", "label": "Edit policy", "sublabel": "Row prefills agent ID"},
    {"id": "validate-save", "lane": "availability-domain", "col": 2, "type": "security", "label": "Validate save", "sublabel": "Captain + policy rules"},
    {"id": "audited-policy", "lane": "availability-domain", "col": 3, "type": "database", "label": "Audited policy", "sublabel": "Ash / PostgreSQL"},
    {"id": "roster-refresh", "lane": "captain-ui", "col": 4, "type": "frontend", "label": "Updated roster", "sublabel": "Close on success"},
    {"id": "cancel-dialog", "lane": "modal-recovery", "col": 1, "type": "frontend", "label": "Cancel dialog", "sublabel": "No policy write"},
