load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cli",
    srcs = ["availability.go", "decisions.go", "root.go", "board.go", "messages.go", "watch.go", "quota.go", "documents.go", "skills.go", "context.go", "worker.go", "chat.go", "prs.go", "seat.go"],
    importpath = "github.com/carverauto/agentboard/internal/cli",
    visibility = ["//:__subpackages__"],
    deps = [
        "//:skill_bundle",
	"//internal/client",
        "//internal/config",
        "//internal/worker",
        "@com_github_spf13_cobra//:cobra",
    ],
)
go_test(
    name = "cli_test",
    srcs = ["root_test.go", "skills_test.go", "chat_test.go", "seat_test.go"],
    deps = [":cli", "//internal/client"],
    size = "small",
)

filegroup(name = "format_srcs", srcs = glob(["*.go"]), visibility = ["//visibility:public"])
