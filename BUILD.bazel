load("@io_bazel_rules_go//go:def.bzl", "go_library")

package(default_visibility = ["//visibility:public"])

exports_files(["go.mod", "go.sum"])

# Go CLI entrypoint (agents call `agentboard`).
alias(
    name = "agentboard",
    actual = "//cmd/agentboard:agentboard",
)

