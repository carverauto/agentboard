  "cards": [
    {
      "dot": "cyan",
      "title": "Observe is adoption evidence",
      "items": [
        "Default off preserves current behavior; observe records verified identity separately",
        "Anonymous and mismatched writes still follow legacy authorization",
        "Enforcement and deployment changes require separate captain direction"
      ]
    },
    {
      "dot": "emerald",
      "title": "Credential custody remains separate",
      "items": [
        "Captain capability alone administers credentials; ordinary attribution grants no access",
        "CLI creates a new protected file and never prints the issued value",
        "Worker and Mattermost credentials keep their existing independent verifiers"
      ]
    }
  ]
