# syntax=docker/dockerfile:1
# PostgreSQL 18.6 with the pinned WAL-backed BM25 extension for Compose.
ARG POSTGRES_IMAGE=postgres:18.6-bookworm@sha256:afc7e2d441324c0388fa80c3d24f733b4194a4eb7f47dd8ee2b08eb1a24a647c
FROM ${POSTGRES_IMAGE} AS extension
USER root
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && case "${TARGETARCH:-amd64}" in \
         amd64) extension_sha=6adc4c390c61109af337c5d5c15239623d6fc8b89e972625de04f52a5771cebf ;; \
         arm64) extension_sha=54843473cbad144812be0437bc708233087c7823018700ffb99a2fb92d1466bb ;; \
         *) echo 'Supported database architectures: amd64, arm64' >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/timescale/pg_textsearch/releases/download/v1.5.1/pg-textsearch-v1.5.1-pg18-${TARGETARCH:-amd64}.zip" -o /tmp/extension.zip \
    && echo "$extension_sha  /tmp/extension.zip" | sha256sum -c - \
    && unzip -q /tmp/extension.zip -d /tmp/package \
    && dpkg-deb -x /tmp/package/*.deb /extension
FROM ${POSTGRES_IMAGE}
COPY --from=extension /extension/usr/lib/postgresql/18/lib/ /usr/lib/postgresql/18/lib/
COPY --from=extension /extension/usr/share/postgresql/18/extension/ /usr/share/postgresql/18/extension/
LABEL org.opencontainers.image.title="agentboard-postgres" \
      org.opencontainers.image.source="https://github.com/carverauto/agentboard" \
      dev.carverauto.pg_textsearch="1.5.1"
