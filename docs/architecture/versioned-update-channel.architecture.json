        420,
        220
      ],
      "size": [
        180,
        80
      ]
    },
    {
      "id": "state",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "Snapshot + notice receipts",
      "pos": [
        800,
        220
      ],
      "size": [
        190,
        80
      ]
    },
    {
      "id": "cli",
      "type": "external",
      "label": "CLI + skill installer",
      "sublabel": "Explicit local upgrades",
      "pos": [
        40,
        490
      ],
      "size": [
        200,
        80
      ]
    },
    {
      "id": "api",
      "type": "backend",
      "label": "Phoenix / Ash API",
      "sublabel": "Reports + update reads",
      "pos": [
        420,
        490
      ],
      "size": [
        180,
        80
      ]
    },
    {
      "id": "readers",
      "type": "frontend",
      "label": "Dashboard + inbox",
      "sublabel": "Actionable version notices",
      "pos": [
        800,
        490
      ],
      "size": [
        200,
        80
      ]
    }
  ],
  "connections": [
    {
      "id": "fetch",
      "from": "release",
      "to": "observer",
      "label": "Validated manifest"
    },
    {
      "id": "commit",
      "from": "observer",
      "to": "state",
      "label": "Durable snapshot"
    },
    {
      "id": "report",
      "from": "cli",
      "to": "api",
      "label": "Opt-in installed versions"
    },
    {
      "id": "query",
      "from": "api",
      "to": "state",
      "label": "Ash actions",
      "fromSide": "top",
      "toSide": "bottom"
    },
    {
      "id": "read",
      "from": "api",
      "to": "readers",
      "label": "Status + notices"
    },
    {
      "id": "download",
      "from": "release",
      "to": "cli",
      "label": "Verified assets",
      "fromSide": "bottom",
      "toSide": "top"
