package(default_visibility = ["//visibility:public"])

exports_files(["go.mod", "go.sum"])

# Go CLI entrypoint (agents call `ab`).
alias(
    name = "ab",
    actual = "//cmd/ab:ab",
)

filegroup(
    name = "release_artifacts",
    srcs = [
        "//build/release:cli_artifacts",
        "//build/release:dashboard",
        "//build/release:dashboard.digest",
        "//web:release",
    ],
)

test_suite(
    name = "acceptance",
    tests = [
        "//internal/client:client_test",
        "//internal/cli:cli_test",
        "//web:rate_limits_test",
        "//build/integration:postgres_tls_test",
        "//build/integration:release_schema_test",
        "//build/integration:board_api_test",
        "//build/integration:image_startup_test",
        "//build/release:cli_artifacts_test",
        "//build/release:workflow_tools_test",
    ],
)
