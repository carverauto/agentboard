package(default_visibility = ["//visibility:public"])

# Linux amd64 remote-exec platform for BuildBuddy RBE.
# Image shared with ServiceRadar / Contour executors; tighten constraints
# (Erlang/Elixir toolchains, etc.) once those packages land in MODULE.bazel.
platform(
    name = "platform",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "Arch": "amd64",
        "dockerNetwork": "bridge",
        "container-image": "docker://registry.carverauto.dev/serviceradar/rbe-executor:v1.0.25.1@sha256:779e9889e18fd8c7a3372d79a130c3d346205fcbfc8190d12c8393b88692dfa5",
    },
)
