genrule(
    name = "liveview_rendered",
    srcs = ["liveview_render.mjs", "@hex_phoenix_live_view//:sources", "@hex_phoenix_live_view//:browser_js"],
    outs = ["liveview-render.mjs"],
    cmd = """
      set -euo pipefail
      sdk_root=$$(dirname "$(location @hex_phoenix_live_view//:browser_js)")/../..
      "$(location @esbuild_linux_x86_64//:bin)" build/integration/liveview_render.mjs --bundle --platform=node --format=esm --outfile=$@ \
