genrule(
    name = "postgres_runtime",
    srcs = ["@test_postgresql_18_deb//file", "@test_postgresql_client_18_deb//file", "@test_libpq5_deb//file", "@test_libicu74_deb//file", "@test_libxml2_deb//file", "@test_libxslt_deb//file", "@test_liburing2_deb//file", "@test_libnuma1_deb//file", "@test_libldap2_deb//file", "@pg_textsearch_18//:deb"],
    outs = ["postgres-runtime.tar.gz"],
    cmd = """
      set -euo pipefail
      scratch=$$(mktemp -d)
      trap 'rm -rf "$$scratch"' EXIT
      for deb in $(SRCS); do dpkg-deb -x "$$deb" "$$scratch"; done
      tar -czf $@ -C "$$scratch" usr
    """,
)

