load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "worker",
    srcs = ["adapter.go", "api.go", "config.go", "install.go", "journal.go", "runtime.go", "storage_unix.go"],
    embedsrcs = ["pi-native.mjs", "codex-native.mjs"] + glob(["claude-native/**", "claude-native/.mcp.json", "claude-native/.claude-plugin/plugin.json"], exclude = ["claude-native/.claude-plugin/types/**", "claude-native/tsconfig.json"]),
    importpath = "github.com/carverauto/agentboard/internal/worker",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/client", "//internal/config"],
)
go_test(
    name = "worker_test",
    srcs = ["api_access_test.go"],
    deps = [":worker"],
    size = "small",
)
filegroup(name = "format_srcs", srcs = glob(["*.go"]), visibility = ["//visibility:public"])
exports_files(["pi-native.mjs", "claude-native/bridge.mjs", "codex-native.mjs"])
filegroup(name = "claude_native", srcs = glob(["claude-native/**", "claude-native/.mcp.json", "claude-native/.claude-plugin/plugin.json"], exclude = ["claude-native/.claude-plugin/types/**", "claude-native/tsconfig.json"]), visibility = ["//visibility:public"])
