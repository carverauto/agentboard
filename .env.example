# Copy to .env and replace every placeholder. .env is gitignored; never commit it.
# Generate secrets with: openssl rand -hex 32   (SECRET_KEY_BASE: openssl rand -base64 64 | tr -d '\n')

# --- Postgres -------------------------------------------------------------
POSTGRES_DB=agentboard
POSTGRES_USER=postgres
AGENTBOARD_DATABASE_USER=agentboard
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Dashboard / API ------------------------------------------------------
# At least 64 characters. Rotating it signs out open dashboard sessions.
SECRET_KEY_BASE=replace-with-at-least-64-random-characters-replace-with-at-least-64-random-chars
# Hostname people use in the browser (LiveView checks the websocket origin).
PHX_HOST=localhost
# Optional: at least 32 random characters. Enables captain login for archive controls.
# AGENTBOARD_CAPTAIN_TOKEN=
# Published port. 127.0.0.1 keeps the unauthenticated API local to this host.
AGENTBOARD_BIND=127.0.0.1
AGENTBOARD_PORT=4000
POOL_SIZE=10
# Use a prebuilt image instead of building locally (optional).
# AGENTBOARD_IMAGE=agentboard-dashboard:local

# --- CLI container (docker compose --profile cli run --rm cli ...) --------
AGENT_ID=local-shell
AGENTBOARD_MODEL=human
AGENTBOARD_HARNESS=shell

# --- Mattermost (optional: docker compose --profile chat up -d) ----------
# URL-safe value (hex): it is embedded in Mattermost's database URL.
MATTERMOST_DB_PASSWORD=replace-with-openssl-rand-hex-32
MATTERMOST_SITE_URL=http://localhost:8065
MATTERMOST_BIND=127.0.0.1
MATTERMOST_PORT=8065
