#!/usr/bin/env python3
"""Install checksum-pinned Treehouse v3.1.2 without replacing the global CLI."""
import hashlib
import os
from pathlib import Path
import platform
import subprocess
import sys
import tarfile
import tempfile

VERSION = "3.1.2"
CHECKSUMS = {
    ("Linux", "x86_64"): ("linux-amd64", "bc059c6dbbcf6b11a741e92aed1d845d5b4a96f1d9c5e6f78c1aa2502669962d"),
    ("Linux", "aarch64"): ("linux-arm64", "999e6f4888cfd4e6c0b97d49a4857355208bcba080aa2c59902f7fa77b940c0a"),
    ("Darwin", "arm64"): ("darwin-arm64", "24666ddec346b5fd1f0467f475c647d8e2ce45e80e8a84548eade97b353cbe4b"),
    ("Darwin", "x86_64"): ("darwin-amd64", "19a3a79c792139e36c1f5c3e9e0f9fdebe9127f1168b1debb40b4513ffed1319"),
}


def main():
    if len(sys.argv) > 2:
        raise RuntimeError("usage: scripts/install-treehouse [destination-directory]")
    target, checksum = CHECKSUMS[(platform.system(), platform.machine())]
    destination = Path(sys.argv[1]) if len(sys.argv) == 2 else Path.home() / f".local/share/agentboard/tools/treehouse/v{VERSION}"
    url = f"https://github.com/kunchenguid/treehouse/releases/download/v{VERSION}/treehouse-v{VERSION}-{target}.tar.gz"
    with tempfile.TemporaryDirectory(prefix="agentboard-treehouse-install-") as scratch:
        archive = Path(scratch) / "treehouse.tar.gz"
        subprocess.run(["curl", "--fail", "--location", "--silent", "--show-error",
                        "--connect-timeout", "15", "--max-time", "90",
                        "--max-filesize", str(15 * 1024 * 1024),
                        "--output", str(archive), url], check=True, timeout=100)
        payload = archive.read_bytes()
        if len(payload) > 15 * 1024 * 1024 or hashlib.sha256(payload).hexdigest() != checksum:
            raise RuntimeError("release archive checksum/size mismatch")
        archive.write_bytes(payload)
        with tarfile.open(archive) as bundle:
            members = [member for member in bundle.getmembers() if member.name == "treehouse" and member.isfile()]
            if len(members) != 1:
                raise RuntimeError("release must contain exactly one regular treehouse binary")
            with bundle.extractfile(members[0]) as stream:
                binary = Path(scratch) / "treehouse"
                binary.write_bytes(stream.read())
        binary.chmod(0o755)
        version = subprocess.check_output([str(binary), "--version"], text=True, timeout=15).strip()
        if version != f"v{VERSION}":
            raise RuntimeError(f"unexpected binary version: {version}")
        destination.mkdir(parents=True, exist_ok=True)
        # Stage in the destination filesystem, then publish atomically.
        fd, staged = tempfile.mkstemp(prefix=".treehouse-", dir=destination)
        try:
            with os.fdopen(fd, "wb") as stream:
                stream.write(binary.read_bytes())
            os.chmod(staged, 0o755)
            os.replace(staged, destination / "treehouse")
        finally:
            if os.path.exists(staged):
                os.unlink(staged)
    print(destination / "treehouse")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, KeyError, subprocess.SubprocessError) as error:
        print(f"Treehouse install failed: {error}", file=sys.stderr)
        sys.exit(1)
